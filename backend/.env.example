# ==========================================
# UEH TRACKER BACKEND CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://ueh_admin:ueh_secret_password@localhost:5432/ueh_tracker_db?schema=public

# Security & JWT Tokens
JWT_ACCESS_SECRET=ueh_tracker_super_secure_access_secret_key_2026
JWT_REFRESH_SECRET=ueh_tracker_super_secure_refresh_secret_key_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend CORS Whitelist
CORS_ORIGIN=http://localhost:5173
